# Copy to .env and fill in. .env is read by config.py (no dependencies needed).

AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional: cost reporting. Price per 1M tokens, in USD. Leave at 0 to show tokens only.
AZURE_PRICE_INPUT_PER_1M=0
AZURE_PRICE_OUTPUT_PER_1M=0
